#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:
	# All three suites are self-contained: soloist-fetch's CDN and
	# soloist-update's soloist-fetch are always faked (sed-substituted copies
	# pointed at a loopback HTTP server or a local mock script), and
	# soloist-bridge's tests exec() the pure translation functions with no
	# network or subprocess involved -- so all three touch no real network
	# and are safe to run on every build. A suite nothing executes rots, so
	# wire all three in rather than leaving this target empty.
	tests/test_soloist_fetch.sh
	tests/test_soloist_update.sh
	python3 -m pytest tests/test_soloist_bridge.py -v

override_dh_auto_install:
	mkdir -p debian/hifiberry-soloist-wrapper
	cp -r data/* debian/hifiberry-soloist-wrapper/
	install -D -m0755 scripts/soloist-fetch debian/hifiberry-soloist-wrapper/usr/bin/soloist-fetch
	install -D -m0755 scripts/soloist-update debian/hifiberry-soloist-wrapper/usr/bin/soloist-update
	install -D -m0755 scripts/start-soloist debian/hifiberry-soloist-wrapper/usr/bin/start-soloist
	install -D -m0755 scripts/soloist-bridge debian/hifiberry-soloist-wrapper/usr/bin/soloist-bridge

# This package ships five *user* units and they must NOT all get the same
# enable treatment (see usbaudio's debian/rules / README.md for the same
# idiom applied to a WebUI-toggleable player alongside always-on units):
#
#  - soloist.service is the WebUI-toggleable player, like every other
#    HiFiBerryOS player (sendspin, librespot, shairport, ...): it ships
#    disabled and the user turns it on from Services > Players. Shipping it
#    enabled would pull it into every boot transaction regardless of the
#    WebUI toggle, and its Conflicts=librespot.service means that can cost a
#    device its only working Spotify Connect endpoint (see the fix-round
#    brief for the full failure chain). /usr/bin/start-soloist (Task 3) is
#    implemented now, but the toggle-vs-Conflicts reasoning above still
#    holds regardless, so this stays --no-enable.
#  - soloist-update.timer and soloist-update.path stay enabled. They are the
#    90-day expiry safety net for a player the user may not even have
#    enabled yet, and both are no-ops when nothing is installed: the timer
#    only spawns soloist-update, which exits 0 with nothing to refresh if
#    there is no version.json (see scripts/soloist-update), and the path
#    unit only fires on an expiry flag that only start-soloist ever writes.
#  - soloist-bridge.service ALSO stays enabled, unlike an earlier revision
#    of this package. It is the only server for GET /api/soloist/status and
#    POST /api/soloist/install, and those must work even before the user has
#    ever enabled Soloist itself -- that is the WebUI's very first state,
#    "Installed, no binary -> Download Soloist from Spotify". Leaving it
#    off this list (relying solely on soloist.service's
#    Wants=soloist-bridge.service to start it) meant nothing ever listened
#    on 127.0.0.1:3549 until the player was started once, which the
#    Conflicts=librespot.service on soloist.service makes actively harmful
#    to try as a workaround. See soloist-bridge.service's own [Install]
#    comment for the full reasoning, including why its boot-time idle cost
#    on a device that never enables Soloist is negligible next to that.
#  - soloist-update.service is the only one left off this list: it carries
#    no [Install] section, so dh_installsystemduser has nothing to enable.
#    Its file is still installed (via the cp -r data/* above;
#    dh_installsystemduser here only manages enable symlinks, not the copy).
#    It is only ever pulled in as a Unit= target by the path unit or invoked
#    directly.
override_dh_installsystemduser:
	dh_installsystemduser soloist-update.path soloist-update.timer soloist-bridge.service
	dh_installsystemduser --no-enable soloist.service
