#!/usr/bin/env python3
"""soloist-bridge — connect Spotify Soloist's local WebSocket to audiocontrol.

Soloist exposes a rich local WebSocket (events and commands) but no HTTP API,
and audiocontrol's generic player speaks HTTP in both directions. This process
is the adapter, and it is also where the WebUI's setup API lives.

Runs as a systemd *user* service alongside soloist itself.

Volume is deliberately NOT part of this bridge. Soloist attenuates in
software (confirmed on hardware: `set_volume` moves Soloist's own gain but
never touches the PipeWire sink), so two-way volume sync would double-
attenuate. `start-soloist` pins Soloist to --initial-volume 100 once at
login and the device volume is the single control from then on. This file
must never send a `set_volume` command, and `translate()` must drop
`volume_changed` events rather than forwarding them anywhere.
"""
import json
import logging
import os
import pathlib
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib import request as urlrequest
from urllib.error import URLError

LOG = logging.getLogger("soloist-bridge")

DATA_DIR = pathlib.Path.home() / ".local/share/soloist"
VERSION_FILE = DATA_DIR / "version.json"
ACR_UPDATE_URL = "http://localhost:1080/api/player/soloist/update"
COMMAND_PORT = 3549

# Spotify's cover sizes, smallest to largest. Anything unrecognised sorts
# lowest so a new size name never wins by accident. Confirmed against a real
# capture (2026-08-19 spike): all four sizes are sent; large and xlarge can
# carry the identical URL, so "pick the largest" is safe even though it is
# not always a distinct image.
COVER_SIZE_ORDER = ["small", "default", "large", "xlarge"]


def _identity_name(entity):
    """The display name inside an entity envelope, or None."""
    if not isinstance(entity, dict):
        return None
    return (entity.get("decorations", {})
                  .get("identity", {})
                  .get("name"))


def best_cover_url(decorations):
    """The largest cover URL in a decorations block, or None."""
    covers = decorations.get("visual_identity", {}).get("cover")
    if not isinstance(covers, list) or not covers:
        return None

    def rank(cover):
        size = cover.get("size")
        return COVER_SIZE_ORDER.index(size) if size in COVER_SIZE_ORDER else -1

    best = max(covers, key=rank)
    return best.get("url")


def song_from_item(item):
    """Flatten Soloist's entity envelope into audiocontrol's song shape."""
    if not isinstance(item, dict):
        return None
    decorations = item.get("decorations", {}) or {}

    creators = decorations.get("creators") or []
    names = [n for n in (_identity_name(c.get("entity")) for c in creators) if n]
    # ACR's generic song carries a single artist string.
    artist = ", ".join(names) if names else None

    duration_ms = decorations.get("playback", {}).get("duration_ms")

    return {
        "title": decorations.get("identity", {}).get("name"),
        "artist": artist,
        "album": _identity_name(decorations.get("parent", {}).get("entity")),
        "duration": duration_ms / 1000.0 if isinstance(duration_ms, (int, float)) else None,
        "uri": item.get("uri"),
        "cover_art_url": best_cover_url(decorations),
    }


def loop_mode_from_repeat(repeat):
    """Soloist repeat state -> audiocontrol loop mode."""
    return {"track": "track", "context": "playlist"}.get(repeat, "none")


def _queue_entries(upcoming):
    entries = []
    for slot in upcoming or []:
        item = slot.get("item") if isinstance(slot, dict) else None
        song = song_from_item(item)
        if not song or not song["title"]:
            continue
        entries.append({
            "title": song["title"],
            "artist": song["artist"],
            "uri": song["uri"],
        })
    return entries


def translate(event):
    """One Soloist event -> zero or more audiocontrol generic events."""
    kind = event.get("type")

    if kind == "playback_state":
        events = []
        song = song_from_item(event.get("item"))
        if song:
            events.append({"type": "song_changed", "song": song})
        if event.get("status"):
            events.append({"type": "state_changed", "state": event["status"]})
        position = event.get("position") or {}
        if "position_ms" in position:
            events.append({"type": "position_changed",
                           "position": position["position_ms"] / 1000.0})
        options = event.get("options") or {}
        if "shuffle" in options:
            events.append({"type": "shuffle_changed", "shuffle": bool(options["shuffle"])})
        if "repeat" in options:
            events.append({"type": "loop_mode_changed",
                           "loop_mode": loop_mode_from_repeat(options["repeat"])})
        # NOTE: "volume" is present on this payload too, but is deliberately
        # not translated into anything -- see the module docstring. The
        # device volume is the single control; Soloist's own gain is pinned
        # once at login by start-soloist and never touched again.
        return events

    if kind == "track_changed":
        song = song_from_item(event.get("item"))
        return [{"type": "song_changed", "song": song}] if song else []

    if kind == "playback_changed":
        status = event.get("status")
        return [{"type": "state_changed", "state": status}] if status else []

    if kind == "position_sync":
        position = event.get("position") or {}
        if "position_ms" in position:
            # ACR interpolates between updates, so forwarding each sync as-is
            # is enough -- no 1 Hz ticking needed.
            return [{"type": "position_changed",
                     "position": position["position_ms"] / 1000.0}]
        return []

    if kind == "options_changed":
        options = event.get("options") or {}
        events = []
        if "shuffle" in options:
            events.append({"type": "shuffle_changed", "shuffle": bool(options["shuffle"])})
        if "repeat" in options:
            events.append({"type": "loop_mode_changed",
                           "loop_mode": loop_mode_from_repeat(options["repeat"])})
        return events

    if kind == "queue_changed":
        return [{"type": "queue_changed", "queue": _queue_entries(event.get("upcoming"))}]

    # auth_state and device_changed feed /status, not audiocontrol.
    # volume_changed is intentionally dropped -- see the module docstring:
    # the bridge never syncs volume in either direction.
    # context_changed carries no fields audiocontrol's generic song needs
    # (title/artist/album/artwork all come from playback_state/track_changed).
    # error is logged by the caller. Everything else is ignored on purpose.
    return []


def soloist_command(payload):
    """An audiocontrol command_url body -> zero or more Soloist commands.

    Never emits `set_volume` -- see the module docstring. audiocontrol's
    soloist.json capability list has no "volume" entry, so ACR itself never
    sends a volume command here, but the omission is deliberate on this side
    too: this function has no case for it.
    """
    command = payload.get("command")

    if command in ("play", "pause"):
        return [{"type": "command", "command": command}]
    if command == "next":
        return [{"type": "command", "command": "skip_next"}]
    if command == "previous":
        return [{"type": "command", "command": "skip_prev"}]
    if command == "stop":
        # Soloist has no stop. Pause, then release the device.
        return [{"type": "command", "command": "pause"},
                {"type": "command", "command": "deactivate"}]
    if command == "seek":
        position = payload.get("position")
        if not isinstance(position, (int, float)):
            return []
        return [{"type": "command", "command": "seek",
                 "position_ms": int(position * 1000)}]
    if command == "set_shuffle":
        return [{"type": "command", "command": "set_shuffle",
                 "enabled": bool(payload.get("shuffle"))}]
    if command == "set_loop_mode":
        # LoopMode's Display vocabulary: "no" | "song" | "playlist".
        mode = payload.get("loop_mode")
        if mode == "song":
            return [{"type": "command", "command": "set_repeat_track", "enabled": True}]
        if mode == "playlist":
            return [{"type": "command", "command": "set_repeat_context", "enabled": True}]
        return [{"type": "command", "command": "set_repeat_track", "enabled": False},
                {"type": "command", "command": "set_repeat_context", "enabled": False}]

    LOG.debug("Ignoring unknown command %r", command)
    return []


class SoloistConnection:
    """Owns the WebSocket to soloist, and the state /status reports."""

    def __init__(self):
        self._ws = None
        self._lock = threading.Lock()
        self.logged_in = False
        self.is_active = False
        self.device_name = None
        self.connected = False

    # -- endpoint discovery ------------------------------------------------

    @staticmethod
    def _endpoint():
        """Read the address soloist wrote for its ephemeral WebSocket port.

        The port changes every time soloist restarts, so this is re-read on
        every connection attempt rather than cached.
        """
        try:
            addr = (DATA_DIR / "ws.addr").read_text().strip()
            port = (DATA_DIR / "ws.port").read_text().strip()
        except OSError:
            return None
        if not addr or not port:
            return None
        return f"ws://{addr}:{port}"

    # -- outbound ------------------------------------------------------

    def send(self, message):
        with self._lock:
            if self._ws is None:
                LOG.debug("Dropping command, not connected: %r", message)
                return False
            try:
                self._ws.send(json.dumps(message))
                return True
            except Exception as exc:  # noqa: BLE001 - reconnect loop handles it
                LOG.warning("Send failed: %s", exc)
                return False

    # -- inbound -------------------------------------------------------

    def run_forever(self):
        import websocket  # python3-websocket (websocket-client)

        backoff = 1
        while True:
            url = self._endpoint()
            if url is None:
                LOG.debug("No ws.addr/ws.port yet; soloist not running")
                time.sleep(min(backoff, 30))
                backoff = min(backoff * 2, 30)
                continue
            try:
                LOG.info("Connecting to %s", url)
                ws = websocket.create_connection(url, timeout=10)
                with self._lock:
                    self._ws = ws
                self.connected = True
                backoff = 1
                ws.send(json.dumps({"type": "command", "command": "get_state"}))
                self._read_loop(ws)
            except Exception as exc:  # noqa: BLE001 - any failure means reconnect
                LOG.warning("WebSocket error: %s", exc)
            finally:
                self.connected = False
                with self._lock:
                    self._ws = None
                time.sleep(min(backoff, 30))
                backoff = min(backoff * 2, 30)

    def _read_loop(self, ws):
        while True:
            raw = ws.recv()
            if not raw:
                return
            try:
                event = json.loads(raw)
            except ValueError:
                LOG.warning("Non-JSON frame: %r", raw[:200])
                continue

            kind = event.get("type")
            if kind == "auth_state":
                self.logged_in = bool(event.get("logged_in"))
                self.is_active = bool(event.get("is_active"))
                self.device_name = event.get("device_name")
                LOG.info("Auth state: logged_in=%s active=%s name=%s",
                         self.logged_in, self.is_active, self.device_name)
            elif kind == "device_changed":
                self.is_active = bool(event.get("is_active"))
                self.device_name = event.get("device_name") or self.device_name
            elif kind == "error":
                LOG.warning("Soloist error: %s", event.get("message"))

            for acr_event in translate(event):
                post_to_acr(acr_event)


def post_to_acr(event):
    """POST one generic-player event to audiocontrol; failures are not fatal."""
    body = json.dumps(event).encode()
    req = urlrequest.Request(ACR_UPDATE_URL, data=body,
                             headers={"Content-Type": "application/json"},
                             method="POST")
    try:
        with urlrequest.urlopen(req, timeout=2):
            pass
    except URLError as exc:
        LOG.debug("audiocontrol unreachable (%s); dropping %s", exc, event.get("type"))
    except Exception as exc:  # noqa: BLE001
        LOG.debug("Failed to post %s: %s", event.get("type"), exc)


def read_version_info():
    try:
        return json.loads(VERSION_FILE.read_text())
    except (OSError, ValueError):
        return None


def build_status(connection):
    """The payload behind GET /status. Carries no key material."""
    version = read_version_info()
    installed = (pathlib.Path.home() / ".local/bin/soloist").is_file()
    expires_on = None
    if version and version.get("build_date"):
        try:
            import datetime
            built = datetime.date.fromisoformat(version["build_date"])
            expires_on = (built + datetime.timedelta(days=90)).isoformat()
        except ValueError:
            expires_on = None
    return {
        "binary_installed": installed,
        "version": (version or {}).get("version"),
        "build_date": (version or {}).get("build_date"),
        "expires_on": expires_on,
        "bridge_connected": connection.connected,
        "logged_in": connection.logged_in,
        "is_active": connection.is_active,
        "device_name": connection.device_name,
    }


class BridgeHandler(BaseHTTPRequestHandler):
    # NOT named "connection" -- BaseHTTPRequestHandler's superclass
    # (socketserver.BaseRequestHandler) sets self.connection to the raw
    # client socket in its own __init__, which shadows a class attribute
    # of that name on every instance. Confirmed live: naming it "connection"
    # here makes GET /status crash with
    # "'socket' object has no attribute 'connected'" on the very first
    # request, because self.connection resolves to the socket, not to the
    # SoloistConnection set below in main().
    soloist_connection = None  # set in main()
    install_lock = threading.Lock()
    install_state = {"running": False, "returncode": None, "output": ""}

    def log_message(self, fmt, *args):  # quieter than the stdlib default
        LOG.debug("%s - %s", self.address_string(), fmt % args)

    def _json(self, payload, status=200):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/status":
            self._json(build_status(self.soloist_connection))
        elif self.path == "/install":
            self._json(dict(self.install_state))
        else:
            self._json({"error": "not found"}, status=404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b"{}"

        if self.path == "/command":
            try:
                payload = json.loads(raw)
            except ValueError:
                self._json({"error": "invalid json"}, status=400)
                return
            for message in soloist_command(payload):
                self.soloist_connection.send(message)
            self._json({"status": "ok"})
        elif self.path == "/install":
            self._start_install()
            self._json({"status": "started"})
        else:
            self._json({"error": "not found"}, status=404)

    def _start_install(self):
        with self.install_lock:
            if self.install_state["running"]:
                return
            self.install_state.update(running=True, returncode=None, output="")

        def run():
            try:
                result = subprocess.run(["/usr/bin/soloist-fetch"],
                                        capture_output=True, text=True, timeout=600)
                output, code = result.stdout + result.stderr, result.returncode
            except Exception as exc:  # noqa: BLE001
                output, code = str(exc), 1
            with self.install_lock:
                self.install_state.update(running=False, returncode=code, output=output)

        threading.Thread(target=run, daemon=True).start()


def main():
    logging.basicConfig(
        level=logging.DEBUG if os.environ.get("SOLOIST_BRIDGE_DEBUG") else logging.INFO,
        format="%(levelname)s %(name)s: %(message)s",
    )
    connection = SoloistConnection()
    BridgeHandler.soloist_connection = connection

    threading.Thread(target=connection.run_forever, daemon=True).start()

    server = ThreadingHTTPServer(("127.0.0.1", COMMAND_PORT), BridgeHandler)
    LOG.info("Listening on 127.0.0.1:%d", COMMAND_PORT)
    server.serve_forever()


if __name__ == "__main__":
    main()
