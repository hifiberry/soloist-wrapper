#!/usr/bin/env python3
"""soloist-bridge — connect Spotify Soloist's local WebSocket to audiocontrol.

Soloist exposes a rich local WebSocket (events and commands) but no HTTP API,
and audiocontrol's generic player speaks HTTP in both directions. This process
is the adapter, and it is also where the WebUI's setup API lives.

Runs as a systemd *user* service alongside soloist itself.

Volume is deliberately NOT part of this bridge. Soloist attenuates in
software (confirmed on hardware: `set_volume` moves Soloist's own gain but
never touches the PipeWire sink), so two-way volume sync would double-
attenuate. `start-soloist` pins Soloist to --initial-volume 100 once at
login and the device volume is the single control from then on. This file
must never send a `set_volume` command, and `translate()` must drop
`volume_changed` events rather than forwarding them anywhere.
"""
import json
import logging
import os
import pathlib
import queue
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib import request as urlrequest
from urllib.error import URLError

LOG = logging.getLogger("soloist-bridge")

DATA_DIR = pathlib.Path.home() / ".local/share/soloist"
VERSION_FILE = DATA_DIR / "version.json"
ACR_UPDATE_URL = "http://localhost:1080/api/player/soloist/update"
COMMAND_PORT = 3549

# Spotify's cover sizes, smallest to largest. Anything unrecognised sorts
# lowest so a new size name never wins by accident. Confirmed against a real
# capture (2026-08-19 spike): all four sizes are sent; large and xlarge can
# carry the identical URL, so "pick the largest" is safe even though it is
# not always a distinct image.
COVER_SIZE_ORDER = ["small", "default", "large", "xlarge"]


def _identity_name(entity):
    """The display name inside an entity envelope, or None.

    Every `.get(key) or {}` below (rather than `.get(key, {})`) matters:
    Soloist is closed-source and a real capture already showed shapes that
    vary by content type, so an explicit JSON null for any of these keys
    (not just the key being absent) must not raise -- `.get(key, {})` only
    substitutes its default when the key is MISSING, not when it is present
    with value None.
    """
    if not isinstance(entity, dict):
        return None
    return ((entity.get("decorations") or {})
                  .get("identity") or {}).get("name")


def best_cover_url(decorations):
    """The largest cover URL in a decorations block, or None."""
    covers = (decorations.get("visual_identity") or {}).get("cover")
    if not isinstance(covers, list) or not covers:
        return None
    covers = [c for c in covers if isinstance(c, dict)]
    if not covers:
        return None

    def rank(cover):
        size = cover.get("size")
        return COVER_SIZE_ORDER.index(size) if size in COVER_SIZE_ORDER else -1

    best = max(covers, key=rank)
    return best.get("url")


def song_from_item(item):
    """Flatten Soloist's entity envelope into audiocontrol's song shape."""
    if not isinstance(item, dict):
        return None
    decorations = item.get("decorations") or {}

    creators = decorations.get("creators") or []
    names = [n for n in (_identity_name(c.get("entity")) for c in creators
                         if isinstance(c, dict)) if n]
    # ACR's generic song carries a single artist string.
    artist = ", ".join(names) if names else None

    duration_ms = (decorations.get("playback") or {}).get("duration_ms")

    return {
        "title": (decorations.get("identity") or {}).get("name"),
        "artist": artist,
        "album": _identity_name((decorations.get("parent") or {}).get("entity")),
        "duration": duration_ms / 1000.0 if isinstance(duration_ms, (int, float)) else None,
        "uri": item.get("uri"),
        "cover_art_url": best_cover_url(decorations),
    }


def loop_mode_from_repeat(repeat):
    """Soloist repeat state -> audiocontrol loop mode."""
    return {"track": "track", "context": "playlist"}.get(repeat, "none")


def _queue_entries(upcoming):
    entries = []
    for slot in upcoming or []:
        item = slot.get("item") if isinstance(slot, dict) else None
        song = song_from_item(item)
        if not song or not song["title"]:
            continue
        entries.append({
            "title": song["title"],
            "artist": song["artist"],
            "uri": song["uri"],
        })
    return entries


def translate(event):
    """One Soloist event -> zero or more audiocontrol generic events.

    A malformed field anywhere below can still raise (e.g. a non-numeric
    position_ms). That is deliberate: the caller (SoloistConnection.
    _handle_event) wraps the whole per-event dispatch in a try/except so
    one bad event costs one event, not the WebSocket connection -- see its
    docstring. Guessing a fallback value here would risk silently hiding a
    real upstream bug instead.
    """
    kind = event.get("type")

    if kind == "playback_state":
        events = []
        song = song_from_item(event.get("item"))
        if song:
            events.append({"type": "song_changed", "song": song})
        if event.get("status"):
            events.append({"type": "state_changed", "state": event["status"]})
        position = event.get("position") or {}
        if "position_ms" in position:
            events.append({"type": "position_changed",
                           "position": position["position_ms"] / 1000.0})
        options = event.get("options") or {}
        if "shuffle" in options:
            events.append({"type": "shuffle_changed", "shuffle": bool(options["shuffle"])})
        if "repeat" in options:
            events.append({"type": "loop_mode_changed",
                           "loop_mode": loop_mode_from_repeat(options["repeat"])})
        # NOTE: "volume" is present on this payload too, but is deliberately
        # not translated into anything -- see the module docstring. The
        # device volume is the single control; Soloist's own gain is pinned
        # once at login by start-soloist and never touched again.
        return events

    if kind == "track_changed":
        song = song_from_item(event.get("item"))
        return [{"type": "song_changed", "song": song}] if song else []

    if kind == "playback_changed":
        status = event.get("status")
        return [{"type": "state_changed", "state": status}] if status else []

    if kind == "position_sync":
        position = event.get("position") or {}
        if "position_ms" in position:
            # ACR interpolates between updates, so forwarding each sync as-is
            # is enough -- no 1 Hz ticking needed.
            return [{"type": "position_changed",
                     "position": position["position_ms"] / 1000.0}]
        return []

    if kind == "options_changed":
        options = event.get("options") or {}
        events = []
        if "shuffle" in options:
            events.append({"type": "shuffle_changed", "shuffle": bool(options["shuffle"])})
        if "repeat" in options:
            events.append({"type": "loop_mode_changed",
                           "loop_mode": loop_mode_from_repeat(options["repeat"])})
        return events

    if kind == "queue_changed":
        return [{"type": "queue_changed", "queue": _queue_entries(event.get("upcoming"))}]

    # auth_state and device_changed feed /status, not audiocontrol.
    # volume_changed is intentionally dropped -- see the module docstring:
    # the bridge never syncs volume in either direction.
    # context_changed carries no fields audiocontrol's generic song needs
    # (title/artist/album/artwork all come from playback_state/track_changed).
    # error is logged by the caller. Everything else is ignored on purpose.
    return []


def soloist_command(payload):
    """An audiocontrol command_url body -> zero or more Soloist commands.

    Never emits `set_volume` -- see the module docstring. audiocontrol's
    soloist.json capability list has no "volume" entry, so ACR itself never
    sends a volume command here, but the omission is deliberate on this side
    too: this function has no case for it.
    """
    command = payload.get("command")

    if command in ("play", "pause"):
        return [{"type": "command", "command": command}]
    if command == "next":
        return [{"type": "command", "command": "skip_next"}]
    if command == "previous":
        return [{"type": "command", "command": "skip_prev"}]
    if command == "stop":
        # Soloist has no stop. Pause, then release the device.
        return [{"type": "command", "command": "pause"},
                {"type": "command", "command": "deactivate"}]
    if command == "seek":
        position = payload.get("position")
        if not isinstance(position, (int, float)):
            return []
        return [{"type": "command", "command": "seek",
                 "position_ms": int(position * 1000)}]
    if command == "set_shuffle":
        return [{"type": "command", "command": "set_shuffle",
                 "enabled": bool(payload.get("shuffle"))}]
    if command == "set_loop_mode":
        # LoopMode's Display vocabulary: "no" | "song" | "playlist". Also
        # accept "track" as an alias for "song": our own outbound
        # loop_mode_from_repeat() emits "track" (ACR's documented
        # vocabulary is none|song|track|playlist), so a caller that echoes
        # back what we send it must round-trip correctly.
        mode = payload.get("loop_mode")
        if mode in ("song", "track"):
            return [{"type": "command", "command": "set_repeat_track", "enabled": True}]
        if mode == "playlist":
            return [{"type": "command", "command": "set_repeat_context", "enabled": True}]
        return [{"type": "command", "command": "set_repeat_track", "enabled": False},
                {"type": "command", "command": "set_repeat_context", "enabled": False}]

    LOG.debug("Ignoring unknown command %r", command)
    return []


def post_to_acr(event):
    """POST one generic-player event to audiocontrol; failures are not fatal."""
    body = json.dumps(event).encode()
    req = urlrequest.Request(ACR_UPDATE_URL, data=body,
                             headers={"Content-Type": "application/json"},
                             method="POST")
    try:
        with urlrequest.urlopen(req, timeout=2):
            pass
    except URLError as exc:
        LOG.debug("audiocontrol unreachable (%s); dropping %s", exc, event.get("type"))
    except Exception as exc:  # noqa: BLE001
        LOG.debug("Failed to post %s: %s", event.get("type"), exc)


class AcrPoster:
    """Posts translated events to audiocontrol from a dedicated thread.

    post_to_acr() above does a blocking HTTP request. audiocontrol being
    DOWN is fine either way -- connection-refused returns immediately, so
    post_to_acr() drops the event and moves on -- but audiocontrol being
    HUNG (accepting the TCP connection, never responding) would stall
    whoever calls post_to_acr() for up to its timeout, and a single
    playback_state alone expands to five ACR events. Under sustained
    position_sync traffic, calling post_to_acr() straight from the
    WebSocket reader would make the reader fall behind faster than it
    drains -- a shorter timeout only bounds the damage per event, it does
    not eliminate the coupling. Routing every post through a bounded queue
    and a dedicated thread instead makes ACR's latency structurally unable
    to slow down WebSocket reading.

    On overflow the OLDEST queued entry is dropped, not the newest: a stale
    position/song update is a smaller problem than losing whatever just
    happened.
    """

    def __init__(self, maxsize=200):
        self._queue = queue.Queue(maxsize=maxsize)
        threading.Thread(target=self._run, daemon=True).start()

    def submit(self, event):
        try:
            self._queue.put_nowait(event)
        except queue.Full:
            try:
                self._queue.get_nowait()
            except queue.Empty:
                pass
            try:
                self._queue.put_nowait(event)
            except queue.Full:
                pass  # lost a race with another producer; fine to drop

    def _run(self):
        while True:
            event = self._queue.get()
            post_to_acr(event)


class SoloistConnection:
    """Owns the WebSocket to soloist, and the state /status reports."""

    def __init__(self, poster):
        self._ws = None
        self._ws_lock = threading.Lock()  # guards the live websocket object
        # Guards the four fields below as a single unit, so a concurrent
        # GET /status (build_status -> snapshot()) never observes a
        # half-updated set -- e.g. connected already flipped False but
        # logged_in still True from the previous session (Important D).
        self._state_lock = threading.Lock()
        self._poster = poster
        self.logged_in = False
        self.is_active = False
        self.device_name = None
        self.connected = False

    # -- state, read atomically by build_status() ---------------------

    def snapshot(self):
        """Atomic read of the fields build_status() reports."""
        with self._state_lock:
            return {
                "connected": self.connected,
                "logged_in": self.logged_in,
                "is_active": self.is_active,
                "device_name": self.device_name,
            }

    def _mark_connected(self):
        with self._state_lock:
            self.connected = True

    def _mark_disconnected(self):
        """Called whenever the WebSocket goes away, for any reason.

        Resets auth/activity state too, not just `connected` -- otherwise
        /status keeps reporting a stale logged_in/is_active/device_name for
        a daemon that is no longer there (Important D). The next
        successful connection's auth_state frame repopulates all of it.
        """
        with self._state_lock:
            self.connected = False
            self.logged_in = False
            self.is_active = False
            self.device_name = None

    def _update_auth_state(self, logged_in, is_active, device_name):
        with self._state_lock:
            self.logged_in = logged_in
            self.is_active = is_active
            self.device_name = device_name

    def _update_device_changed(self, is_active, device_name):
        with self._state_lock:
            self.is_active = is_active
            if device_name:
                self.device_name = device_name

    # -- endpoint discovery ------------------------------------------------

    @staticmethod
    def _endpoint():
        """Read the address soloist wrote for its ephemeral WebSocket port.

        The port changes every time soloist restarts, so this is re-read on
        every connection attempt rather than cached.
        """
        try:
            addr = (DATA_DIR / "ws.addr").read_text().strip()
            port = (DATA_DIR / "ws.port").read_text().strip()
        except (OSError, ValueError):
            # ValueError also catches UnicodeDecodeError: a non-UTF-8
            # ws.addr/ws.port must not escape this method and kill the
            # reader thread (Important F).
            return None
        if not addr or not port:
            return None
        return f"ws://{addr}:{port}"

    # -- outbound ------------------------------------------------------

    def send(self, message):
        with self._ws_lock:
            if self._ws is None:
                LOG.debug("Dropping command, not connected: %r", message)
                return False
            try:
                self._ws.send(json.dumps(message))
                return True
            except Exception as exc:  # noqa: BLE001 - reconnect loop handles it
                LOG.warning("Send failed: %s", exc)
                return False

    # -- inbound -------------------------------------------------------

    def run_forever(self):
        """Thread target for the WebSocket reader.

        Any exception that escapes this method (a bug, not a day-to-day
        failure like soloist being offline -- that is handled inside the
        loop below) is treated as fatal to the whole PROCESS, not just this
        thread: this runs as a daemon thread, so if it merely died silently,
        main() would keep serving HTTP forever with bridge_connected
        permanently false and Restart=always never firing, because the
        process itself never exits (Important F).
        """
        try:
            self._run_loop()
        except Exception:  # noqa: BLE001 - see docstring: this must be fatal
            LOG.critical("Reader thread died unexpectedly; exiting so systemd restarts us",
                         exc_info=True)
            os._exit(1)

    def _run_loop(self):
        import websocket  # python3-websocket (websocket-client)

        backoff = 1
        while True:
            url = self._endpoint()
            if url is None:
                LOG.debug("No ws.addr/ws.port yet; soloist not running")
                time.sleep(min(backoff, 30))
                backoff = min(backoff * 2, 30)
                continue
            ws = None
            try:
                LOG.info("Connecting to %s", url)
                ws = websocket.create_connection(url, timeout=10)
                # create_connection()'s timeout also becomes the socket's
                # PERSISTENT recv() timeout, not just the handshake's --
                # confirmed from the websocket-client source
                # (self.sock.settimeout(timeout)). Left at 10s, a
                # silent-but-alive connection (a paused device sends
                # nothing) would have recv() raise
                # WebSocketTimeoutException every 10s, which the except
                # below can only read as a dead connection -- producing an
                # endless reconnect-every-~11s cycle on an idle device,
                # each one a full get_state -> 5-event ACR burst and a
                # ~1s bridge_connected:false window (Critical). Clearing
                # the timeout after the handshake makes recv() block
                # indefinitely; a dead daemon is still detected because
                # its socket then errors or closes, not by silence.
                ws.settimeout(None)
                with self._ws_lock:
                    self._ws = ws
                self._mark_connected()
                backoff = 1
                ws.send(json.dumps({"type": "command", "command": "get_state"}))
                self._read_loop(ws)
            except Exception as exc:  # noqa: BLE001 - any failure means reconnect
                LOG.warning("WebSocket error: %s", exc)
            finally:
                self._mark_disconnected()
                with self._ws_lock:
                    self._ws = None
                if ws is not None:
                    try:
                        ws.close()
                    except Exception:  # noqa: BLE001 - already tearing down
                        pass
                # Tell audiocontrol the player is gone rather than leaving
                # it showing the last state forever (Important C). A
                # direct, synchronous post is fine here -- this runs once
                # per reconnect cycle, not once per event, so it cannot
                # become the per-event ACR-latency problem AcrPoster exists
                # to avoid.
                post_to_acr({"type": "state_changed", "state": "disconnected"})
                time.sleep(min(backoff, 30))
                backoff = min(backoff * 2, 30)

    def _read_loop(self, ws):
        while True:
            raw = ws.recv()
            if not raw:
                return
            try:
                event = json.loads(raw)
            except ValueError:
                LOG.warning("Non-JSON frame: %r", raw[:200])
                continue

            try:
                self._handle_event(event)
            except Exception as exc:  # noqa: BLE001 - one bad event must cost
                # one event, not the connection (Important A). Soloist is
                # closed-source and its shapes vary by content type
                # (podcasts, local files, ads) -- a malformed field here
                # (e.g. a string position_ms) must not tear the whole
                # connection down and restart the get_state/re-crash cycle
                # forever.
                LOG.warning("Failed to handle event %r: %s",
                           event.get("type") if isinstance(event, dict) else event, exc)
                continue

    def _handle_event(self, event):
        if not isinstance(event, dict):
            return
        kind = event.get("type")
        if kind == "auth_state":
            self._update_auth_state(bool(event.get("logged_in")),
                                    bool(event.get("is_active")),
                                    event.get("device_name"))
            LOG.info("Auth state: logged_in=%s active=%s name=%s",
                     self.logged_in, self.is_active, self.device_name)
        elif kind == "device_changed":
            self._update_device_changed(bool(event.get("is_active")),
                                        event.get("device_name"))
        elif kind == "error":
            LOG.warning("Soloist error: %s", event.get("message"))

        for acr_event in translate(event):
            self._poster.submit(acr_event)


def read_version_info():
    try:
        return json.loads(VERSION_FILE.read_text())
    except (OSError, ValueError):
        return None


def build_status(connection):
    """The payload behind GET /status. Carries no key material."""
    version = read_version_info()
    installed = (pathlib.Path.home() / ".local/bin/soloist").is_file()
    expires_on = None
    if version and version.get("build_date"):
        try:
            import datetime
            built = datetime.date.fromisoformat(version["build_date"])
            expires_on = (built + datetime.timedelta(days=90)).isoformat()
        except ValueError:
            expires_on = None
    state = connection.snapshot()
    return {
        "binary_installed": installed,
        "version": (version or {}).get("version"),
        "build_date": (version or {}).get("build_date"),
        "expires_on": expires_on,
        "bridge_connected": state["connected"],
        "logged_in": state["logged_in"],
        "is_active": state["is_active"],
        "device_name": state["device_name"],
    }


class BridgeHandler(BaseHTTPRequestHandler):
    # Every attribute this class owns is prefixed "bridge_", on purpose:
    # this class inherits from BaseHTTPRequestHandler, whose ancestor
    # socketserver.BaseRequestHandler sets several UNPREFIXED instance
    # attributes of its own in __init__ -- "connection" (the raw client
    # socket) is one, and "request"/"client_address" are others; "command"
    # and "path" (the parsed request line) are set by
    # BaseHTTPRequestHandler itself. Using a plain name like "connection"
    # here silently shadows the base class's own attribute of that name --
    # which is exactly the bug this file shipped with once already (GET
    # /status crashed with "'socket' object has no attribute 'connected'").
    # The bridge_ prefix makes that whole collision class structurally
    # impossible to hit again, rather than something to re-verify by hand
    # for every new attribute.
    bridge_connection = None  # set in main()
    bridge_install_lock = threading.Lock()
    bridge_install_state = {"running": False, "returncode": None, "output": ""}

    def log_message(self, fmt, *args):  # quieter than the stdlib default
        LOG.debug("%s - %s", self.address_string(), fmt % args)

    def _json(self, payload, status=200):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/status":
            self._json(build_status(self.bridge_connection))
        elif self.path == "/install":
            self._json(dict(self.bridge_install_state))
        else:
            self._json({"error": "not found"}, status=404)

    def _read_body(self):
        """The raw POST body, or None if the request is malformed.

        Guards two ways a body can misbehave: a non-numeric Content-Length
        previously raised ValueError uncaught here, escaping into
        socketserver's handle_error as a traceback with no HTTP response at
        all (Minor A); and chunked Transfer-Encoding, which this handler
        does not decode and would otherwise silently read as an empty body
        and treat as a valid empty command.
        """
        if self.headers.get("Transfer-Encoding", "").lower() == "chunked":
            return None
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        return self.rfile.read(length) if length else b"{}"

    def do_POST(self):
        raw = self._read_body()
        if raw is None:
            self._json({"error": "malformed request"}, status=400)
            return

        if self.path == "/command":
            try:
                payload = json.loads(raw)
            except ValueError:
                self._json({"error": "invalid json"}, status=400)
                return
            # A list comprehension, not a generator passed to all(): all()
            # short-circuits on the first False, which would skip sending
            # the remaining messages of a multi-message command (e.g.
            # "stop" -> pause + deactivate) instead of attempting all of
            # them.
            results = [self.bridge_connection.send(message)
                      for message in soloist_command(payload)]
            if all(results):
                self._json({"status": "ok"})
            else:
                # Propagate the failure instead of claiming success
                # (Important B): audiocontrol has no other way to learn a
                # command never reached Soloist, e.g. during one of the
                # brief disconnect windows a reconnect cycle still has, so
                # it has no reason to retry or surface anything to the user.
                self._json({"status": "error", "message": "not connected to soloist"},
                          status=503)
        elif self.path == "/install":
            self._start_install()
            self._json({"status": "started"})
        else:
            self._json({"error": "not found"}, status=404)

    def _start_install(self):
        with self.bridge_install_lock:
            if self.bridge_install_state["running"]:
                return
            self.bridge_install_state.update(running=True, returncode=None, output="")

        def run():
            try:
                result = subprocess.run(["/usr/bin/soloist-fetch"],
                                        capture_output=True, text=True, timeout=600)
                output, code = result.stdout + result.stderr, result.returncode
            except Exception as exc:  # noqa: BLE001
                output, code = str(exc), 1
            with self.bridge_install_lock:
                self.bridge_install_state.update(running=False, returncode=code, output=output)

        threading.Thread(target=run, daemon=True).start()


def _handle_sigterm(signum, frame):
    """Tell audiocontrol the player is gone before this process dies.

    systemd's PartOf=soloist.service sends SIGTERM here whenever
    soloist.service stops, including via the WebUI toggle. Python's
    default SIGTERM action terminates the process immediately with no
    cleanup, so without this handler audiocontrol keeps showing whatever
    state it last heard (typically "playing") forever afterwards -- there
    is nothing left running that could ever correct it (Important C).
    """
    LOG.info("Received SIGTERM, telling audiocontrol the player is gone")
    try:
        post_to_acr({"type": "state_changed", "state": "disconnected"})
    except Exception:  # noqa: BLE001 - shutting down regardless
        pass
    sys.exit(0)


def main():
    logging.basicConfig(
        level=logging.DEBUG if os.environ.get("SOLOIST_BRIDGE_DEBUG") else logging.INFO,
        format="%(levelname)s %(name)s: %(message)s",
    )
    signal.signal(signal.SIGTERM, _handle_sigterm)

    poster = AcrPoster()
    connection = SoloistConnection(poster)
    BridgeHandler.bridge_connection = connection

    threading.Thread(target=connection.run_forever, daemon=True).start()

    server = ThreadingHTTPServer(("127.0.0.1", COMMAND_PORT), BridgeHandler)
    LOG.info("Listening on 127.0.0.1:%d", COMMAND_PORT)
    server.serve_forever()


if __name__ == "__main__":
    main()
