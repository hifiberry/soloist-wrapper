#!/bin/bash
# soloist-fetch — download Spotify Soloist into the current user's home.
#
# Spotify does not permit redistributing the binary, so it is never in our
# package; it is fetched from Spotify's CDN on the user's own device, on their
# explicit request. Builds expire 90 days after their build date, so this also
# runs periodically from soloist-update.timer.
#
# Exit code taxonomy -- this is a cross-component contract. The WebUI's
# install-progress endpoint (and soloist-update) key off these to say
# something more useful than "it failed", so propagate any change:
#   0  success
#   2  unsupported CPU architecture
#   3  no network: curl could not even reach Spotify's CDN (DNS/connect
#      failure -- curl exit 6 "could not resolve host" or 7 "could not
#      connect")
#   4  broken payload: the archive did not extract, contained no 'soloist'
#      binary, or the binary failed its --version smoke test (wrong
#      arch/non-executable)
#   5  local environment failure: could not create/write to ~/.local/bin or
#      ~/.local/share/soloist (disk full, permissions, stale lock, ...) --
#      distinct from a broken payload because it says "your device", not
#      "Spotify's build"
#   6  download failure: curl reached Spotify's CDN but the request itself
#      failed (HTTP error such as 404/5xx -- curl exit 22 under --fail -- or
#      any other curl failure not classified above)
set -u

BASE_URL="https://soloist-builds.spotifycdn.com"
BIN_DIR="${HOME}/.local/bin"
DATA_DIR="${HOME}/.local/share/soloist"
VERSION_FILE="${DATA_DIR}/version.json"

case "$(uname -m)" in
  aarch64|arm64)  ARCH="arm64"  ;;
  armv7l|armv6l)  ARCH="arm32"  ;;
  x86_64|amd64)   ARCH="x86_64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 2 ;;
esac

mkdir -p "$BIN_DIR" "$DATA_DIR" || {
  echo "Could not create ${BIN_DIR} or ${DATA_DIR}" >&2
  exit 5
}

# Serialise concurrent fetch attempts against this data dir: soloist-update
# (the daily timer, or the expiry path unit) and a WebUI "Update now" action
# can both invoke this script with nothing else stopping them from running
# at the same time. A blocking flock makes the second caller simply wait
# its turn rather than racing the first through install/rename below.
LOCK_FILE="${DATA_DIR}/.fetch.lock"
exec 9>"$LOCK_FILE" || {
  echo "Could not open lock file ${LOCK_FILE}" >&2
  exit 5
}
flock 9

# Unique per-process staging name: two serialised-but-sequential runs (or a
# stray leftover from a killed previous run) must never collide on, or be
# mistaken for, each other's in-progress download.
STAGING="${BIN_DIR}/soloist.new.$$"

TMPDIR_LOCAL=$(mktemp -d)
trap 'rm -rf "$TMPDIR_LOCAL"; rm -f "$STAGING"' EXIT

echo "Downloading Soloist for ${ARCH}..."
curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
        --max-time 300 \
        -o "${TMPDIR_LOCAL}/soloist.tar.gz" \
        "${BASE_URL}/soloist_release_${ARCH}.tar.gz"
CURL_STATUS=$?
if [ "$CURL_STATUS" -ne 0 ]; then
  case "$CURL_STATUS" in
    6|7)
      echo "Could not reach Spotify's CDN (curl exit ${CURL_STATUS}: DNS/connect failure)" >&2
      exit 3
      ;;
    22)
      echo "Spotify's CDN returned an HTTP error (curl exit ${CURL_STATUS})" >&2
      exit 6
      ;;
    *)
      echo "Download failed (curl exit ${CURL_STATUS})" >&2
      exit 6
      ;;
  esac
fi

if ! tar -xzf "${TMPDIR_LOCAL}/soloist.tar.gz" -C "${TMPDIR_LOCAL}"; then
  echo "Archive could not be extracted" >&2
  exit 4
fi

CANDIDATE=$(find "${TMPDIR_LOCAL}" -type f -name soloist -print -quit)
if [ -z "$CANDIDATE" ]; then
  echo "Archive did not contain a 'soloist' binary" >&2
  exit 4
fi
chmod 755 "$CANDIDATE"

# Spotify publishes no checksums, so running --version is the only verification
# available: it proves the file executes on this architecture.
if ! VERSION_OUTPUT=$("$CANDIDATE" --version 2>&1); then
  echo "Downloaded binary does not run: ${VERSION_OUTPUT}" >&2
  exit 4
fi

if ! install -m 755 "$CANDIDATE" "$STAGING"; then
  echo "Could not install binary to ${STAGING}" >&2
  exit 5
fi
if ! mv -f "$STAGING" "${BIN_DIR}/soloist"; then
  echo "Could not move ${STAGING} into place at ${BIN_DIR}/soloist" >&2
  exit 5
fi

# --version prints version, build timestamp, build identifiers, platform and
# architecture. Observed real output (arm64, 2026-08-19):
#   soloist 1.3.7.382 build 1787148122 (20260819) (gb24005ef46) (linux/aarch64)
# There is no ISO (YYYY-MM-DD) date anywhere in it; the build date is a bare
# YYYYMMDD token in parens. Try ISO form first in case a future build changes
# format, then the YYYYMMDD form actually observed, then fall back to today
# so the expiry logic still has a lower bound to work from. The fallback is
# a guess, not a fact, so it is flagged loudly (stderr warning) and recorded
# in version.json's build_date_source so later tasks can tell parsed from
# guessed dates apart.
BUILD_DATE=$(printf '%s\n' "$VERSION_OUTPUT" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1)
if [ -n "$BUILD_DATE" ]; then
  BUILD_DATE_SOURCE="parsed"
else
  BUILD_DATE_RAW=$(printf '%s\n' "$VERSION_OUTPUT" | grep -oE '\(20[0-9]{6}\)' | head -1 | tr -d '()')
  if [ -n "$BUILD_DATE_RAW" ]; then
    BUILD_DATE="${BUILD_DATE_RAW:0:4}-${BUILD_DATE_RAW:4:2}-${BUILD_DATE_RAW:6:2}"
    BUILD_DATE_SOURCE="parsed"
  fi
fi
if [ -z "$BUILD_DATE" ]; then
  BUILD_DATE=$(date -u +%Y-%m-%d)
  BUILD_DATE_SOURCE="fallback"
  echo "WARNING: could not parse a build date from --version output; using today (${BUILD_DATE}) as a lower bound. Raw output: ${VERSION_OUTPUT}" >&2
fi
VERSION=$(printf '%s\n' "$VERSION_OUTPUT" | head -1 | tr -d '"')

cat > "$VERSION_FILE" <<EOF
{
  "version": "${VERSION}",
  "build_date": "${BUILD_DATE}",
  "build_date_source": "${BUILD_DATE_SOURCE}",
  "installed_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "arch": "${ARCH}"
}
EOF

echo "Installed ${BIN_DIR}/soloist (${VERSION}, built ${BUILD_DATE})"

# Clear the expiry flag now that a fresh build is in place. This is
# deliberately done here, on SUCCESS, and not by soloist-update before it
# attempts a refresh -- see soloist-update's header comment for why.
rm -f "${DATA_DIR}/expired"

# Restart the daemon if it was already running, so the new build takes over.
if systemctl --user is-active --quiet soloist 2>/dev/null; then
  systemctl --user restart soloist || true
fi

exit 0
