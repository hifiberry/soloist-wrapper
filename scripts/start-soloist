#!/bin/bash
# start-soloist — launch Spotify Soloist from its systemd *user* service.
#
# The API key lives only in ConfigDB, encrypted. It is read here into a shell
# variable and handed straight to the daemon; it is never written to disk by
# us. curl's body is captured straight into a shell variable via command
# substitution (-w '\n%{http_code}' appended so the HTTP status can still be
# split from the body afterwards) -- no temp file ever holds it, and a bash
# here-string (<<<) is avoided too since bash may back one with a real temp
# file under some configurations, which would reintroduce the same problem
# in a way that is not obvious from reading this script.
#
# PipeWire routing: deliberately no --pipewire-device. Measured on real
# hardware (2026-08-19 spike): the default sink is already
# speakereq2x2 (HiFiBerry's EQ chain) and Soloist's stream routes there
# correctly on its own. Naming a node explicitly would risk pinning audio to
# the raw ALSA device and bypassing the EQ, so the flag is omitted entirely.
#
# --initial-volume 100 is mandatory, not cosmetic. Soloist's own default is
# 40 and it attenuates in SOFTWARE (confirmed on hardware: sending
# set_volume 40 over the control websocket left the PipeWire sink volume at
# 1.00, unchanged) -- so an unconfigured Soloist ships roughly 8 dB quieter
# than the librespot it replaces, with nothing in the UI to explain why.
# Soloist has no ALSA mixer options at all, so pinning it at 100 and letting
# the device volume be the single control is the only workable arrangement;
# do not remove this flag or "sync" it to anything.
set -u

DATA_DIR="${HOME}/.local/share/soloist"
CACHE_DIR="${HOME}/.cache/soloist"
BIN="${HOME}/.local/bin/soloist"
CONFIG_SERVER="http://127.0.0.1:1081"

# Run only as root or the configured HiFiBerry user (mirrors start-librespot).
CURRENT_USER=$(whoami)
if [ "$CURRENT_USER" != "root" ]; then
  if [ -f /etc/hifiberry.user ]; then
    AUTH_USER=$(tr -d '\n\r ' < /etc/hifiberry.user)
    if [ "$CURRENT_USER" != "$AUTH_USER" ]; then
      echo "Not starting soloist: must run as $AUTH_USER"
      exit 0
    fi
  else
    echo "Not starting soloist: /etc/hifiberry.user not found and not running as root"
    exit 0
  fi
fi

if ! /usr/bin/config-soundcard --detect >/dev/null 2>&1; then
  echo "No sound card detected, not starting soloist"
  exit 0
fi

# Exit 0, not non-zero: an unconfigured device must sit quietly rather than
# restart-looping. The WebUI card is what tells the user what is missing.
if [ ! -x "$BIN" ]; then
  echo "Soloist is not installed yet (no $BIN). Run soloist-fetch."
  exit 0
fi

# Two genuinely different failure modes hide behind "no key", and they need
# different exits. config-server answering HTTP 404 for the key (checked
# below against the ACTUAL numeric status code, not curl's --fail/exit-22
# shorthand -- --fail collapses EVERY status >= 400 into the same exit 22,
# so a 500/503 from config-server, e.g. a ConfigDB lock or internal error
# while the service is otherwise up, would land on the same branch as a
# genuine 404 and get reported as "not configured") means the device is
# honestly unconfigured -- log the WebUI message and exit 0 so an
# unconfigured device sits quiet rather than restart-looping. Everything
# else -- config-server unreachable (curl exit 6/7/28/...; not an HTTP
# response at all), a non-404 HTTP error (500, 503, an unexpected 4xx), or a
# 200 body that doesn't parse into the shape we expect -- is
# TRANSIENT/unknown, and must exit NON-ZERO so soloist.service's
# Restart=on-failure actually retries; exiting 0 for any of these would
# leave the player silently and permanently down after nothing worse than
# config-server hiccuping. This call is direct loopback to config-server's
# own port (127.0.0.1:1081), not through the nginx auth gateway, so a
# spurious 401/403 is not a realistic case here and isn't special-cased.
#
# "Unreachable" gets one more twist: config-server is itself
# After=network-online.target, and on a device with slow DHCP/Wi-Fi it can
# still be starting up when this runs at boot. Unlike a slow response,
# connection-refused/connect-failure returns from curl almost instantly, so
# five RestartSec=2 attempts exhaust StartLimitBurst=5 inside the default
# StartLimitIntervalSec=10s and land soloist.service permanently failed for
# the rest of the boot -- with librespot already stopped by Conflicts=. A
# user unit cannot order itself against a system unit's actual readiness
# (only After=, which does not bound how long that takes), so the
# unreachable case is retried HERE, inside this one invocation, for up to
# 60s before giving up -- by which point it is a real, ongoing problem, not
# a boot race, and letting systemd's own restart loop take over is
# meaningful again. The 404/500/parse-error branches below are not part of
# this retry: config-server having actually answered means it is up, so
# there is no boot race left to wait out for those.
ERR_FILE=$(mktemp) || ERR_FILE=""
if [ -z "$ERR_FILE" ]; then
  echo "Could not create a temp file to hold config-server's curl error output" >&2
  exit 1
fi

RETRY_DEADLINE=$(( $(date +%s) + 60 ))
while :; do
  # -w '\n%{http_code}' appends the HTTP status after a newline so it can be
  # split from the body below; command substitution keeps the whole response
  # in RESP, in memory, never on disk. --show-error puts curl's own error
  # text in ERR_FILE so a transport failure names the real cause instead of
  # leaving just an empty body.
  RESP=$(curl --silent --show-error --max-time 5 -w '\n%{http_code}' \
    "${CONFIG_SERVER}/api/v1/key/player.soloist.api_key/secure" 2>"$ERR_FILE")
  CURL_STATUS=$?
  [ "$CURL_STATUS" -eq 0 ] && break
  CURL_ERR=$(cat "$ERR_FILE" 2>/dev/null)
  if [ "$(date +%s)" -ge "$RETRY_DEADLINE" ]; then
    break
  fi
  echo "Could not reach config-server for the API key yet (curl exit ${CURL_STATUS}): ${CURL_ERR}; retrying for up to 60s in case it is still starting" >&2
  sleep 2
done
rm -f "$ERR_FILE"

if [ "$CURL_STATUS" -ne 0 ]; then
  echo "Could not reach config-server for the API key after retrying for 60s (curl exit ${CURL_STATUS}): ${CURL_ERR:-}" >&2
  exit 1
fi

HTTP_STATUS=${RESP##*$'\n'}
BODY=${RESP%$'\n'*}

if [ "$HTTP_STATUS" = "404" ]; then
  echo "No Soloist API key configured. Enter one in the HiFiBerry web interface."
  exit 0
fi

if [ "$HTTP_STATUS" != "200" ]; then
  BODY_SNIPPET=$(printf '%s' "$BODY" | head -c 200)
  echo "config-server returned HTTP ${HTTP_STATUS} for the API key (expected 200 or 404): ${BODY_SNIPPET}" >&2
  exit 1
fi

# config-server answered 200; still distinguish a well-formed "no value" (or
# a JSON null, which json.load turns into Python None -- falsy, same as
# missing or empty) from a body that is not even in the shape we expect.
# The former is genuinely unconfigured (exit 0, sit quiet); the latter is
# unknown/transient (exit 1, let systemd retry) rather than misreporting it
# as "not configured", which is exactly the assertion that misdirects.
API_KEY=$(printf '%s' "$BODY" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    if not isinstance(d, dict) or d.get("status") != "success" or not isinstance(d.get("data"), dict):
        sys.exit(1)
    value = d["data"].get("value")
except Exception:
    sys.exit(1)
if value:
    print(value)
    sys.exit(0)
sys.exit(2)
' 2>/dev/null)
PARSE_STATUS=$?

if [ "$PARSE_STATUS" -eq 2 ]; then
  echo "No Soloist API key configured. Enter one in the HiFiBerry web interface."
  exit 0
fi
if [ "$PARSE_STATUS" -ne 0 ] || [ -z "${API_KEY:-}" ]; then
  echo "config-server's response for the API key was not in the expected shape; treating as transient" >&2
  exit 1
fi

NAME=$(hostnamectl hostname --pretty 2>/dev/null)
[ -n "$NAME" ] || NAME=$(hostname 2>/dev/null)
[ -n "$NAME" ] || NAME="HiFiBerry"

mkdir -p "$DATA_DIR" "$CACHE_DIR"

# Builds expire 90 days after their build date and exit 10. Leave a flag the
# soloist-update.path unit watches, so a device that was switched off for a
# long time repairs itself instead of restart-looping. See soloist-update's
# header comment for the full clear/don't-clear contract: only soloist-fetch
# clears this flag, and only on a successful fetch.
#
# Only touch the flag the FIRST time it is observed missing. soloist.service
# has Restart=on-failure with RestartSec=2, and systemd's PathExists=
# re-triggers on IN_ATTRIB, not just create/delete -- so once the daemon is
# stuck exiting 10 in a tight restart loop, a touch on every single restart
# would re-fire soloist-update.path every ~2s and burn through its
# TriggerLimitBurst=3/TriggerLimitIntervalSec=1h within seconds, parking the
# path unit in a permanent failed state for the rest of the boot. Writing
# the flag once is enough; it already being there on a later failed start is
# not itself an error.
cleanup_on_expiry() {
  local status=$1
  if [ "$status" -eq 10 ]; then
    if [ ! -f "${DATA_DIR}/expired" ]; then
      echo "Soloist build has expired; requesting an update"
      touch "${DATA_DIR}/expired"
    else
      echo "Soloist build has expired (flag already set; not re-touching)"
    fi
  fi
  exit "$status"
}
trap 'cleanup_on_expiry $?' EXIT

echo "Starting Soloist as \"$NAME\""
"$BIN" \
  --device-name "$NAME" \
  --api-key "$API_KEY" \
  --data-dir "$DATA_DIR" \
  --cache-dir "$CACHE_DIR" \
  --cache-size 500 \
  --initial-volume 100 \
  --ws 127.0.0.1:0
