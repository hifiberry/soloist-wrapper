#!/bin/bash
# soloist-update — re-fetch Soloist before its build expires.
#
# Spotify's builds expire 90 days after their build date and then exit 10.
# Refresh well before that so devices that are off, offline, or only powered
# on occasionally still catch the refresh before the real deadline.
#
# soloist-fetch records how it learned build_date in build_date_source:
#   "parsed"   — read straight from the binary's own --version output. A fact.
#   "fallback" — the parser found no date in --version output and used the
#                install date instead. A LOWER BOUND, not a fact: the real
#                build could be considerably older, so the true expiry may
#                arrive well before 90 days from the recorded date.
# A "fallback" date is less information, not the same information, so it
# gets a shorter, more conservative threshold than a "parsed" one. Anything
# other than exactly "parsed" (missing field, unrecognised value, ...) is
# treated the same conservative way, since it means we don't actually know
# how the date was derived.
#
# The expiry flag ($DATA_DIR/expired) is written by start-soloist when the
# daemon exits 10 (build expired). It is a SIGNAL that a refresh is needed,
# and this script is not allowed to clear it before it has actually been
# acted on: the commonest reason a build reaches expiry is that the device
# was off or offline, which is exactly when the ensuing fetch also fails. If
# soloist-update deleted the flag up front and the fetch then failed, the
# flag would be gone and soloist-update.path would never fire again. So only
# soloist-fetch clears it, and only once a fetch actually SUCCEEDS.
# start-soloist does not need to keep rewriting the flag on every failed
# restart -- writing it once, the first time it observes exit 10, is enough;
# the flag already existing on a later failed start is not itself an error,
# and soloist-fetch's success path is the only thing that removes it.
# soloist-update.path guards against the hot-loop this would otherwise cause
# (a failed fetch leaves the flag in place, and PathExists= re-triggers as
# soon as the oneshot exits) with TriggerLimitIntervalSec/TriggerLimitBurst
# (see that unit's own comment for exactly what this does and does not do).
# It is NOT a bounded retry loop: once its burst is exceeded, systemd parks
# soloist-update.path in a permanent "failed" state for the rest of the
# boot -- no more retries until the unit is reset or the device reboots.
# That is fine here specifically because soloist-update.timer (daily) is an
# independent unit that is unaffected by the path unit's failure and always
# refetches on its next run: an expired build is by definition >90 days
# old, already past both the 60-day parsed and 30-day fallback thresholds
# above, so the timer alone guarantees recovery regardless of whether the
# path unit is still watching. The path unit only buys a chance at faster
# recovery than waiting for tomorrow's timer, for a transient failure.
set -u

BIN_DIR="${HOME}/.local/bin"
SOLOIST_BIN="${BIN_DIR}/soloist"
DATA_DIR="${HOME}/.local/share/soloist"
VERSION_FILE="${DATA_DIR}/version.json"
MAX_AGE_DAYS_PARSED=60
MAX_AGE_DAYS_FALLBACK=30

# The binary is the source of truth for "is anything installed", not
# version.json: soloist-fetch installs the binary before it writes
# version.json, so an interrupted fetch (power loss, SIGKILL, a cancelled
# background install job) or anything else that clears Soloist's own
# ~/.local/share/soloist data directory can leave binary-present/no-
# version.json. Treating that as "nothing installed yet" would mean the
# build silently sails past 90 days with no updater ever running again.
if [ ! -x "$SOLOIST_BIN" ]; then
  echo "No soloist binary at ${SOLOIST_BIN}; nothing installed yet, not updating"
  # If the expiry flag is somehow set with no binary in place (e.g. the
  # binary was removed out from under an otherwise-expired install), it is
  # now stale: there is nothing left to expire. Leaving it would make
  # soloist-update.path re-trigger on every run without ever clearing it,
  # until its TriggerLimitBurst parks the path unit in a permanently failed
  # state -- a dead end this cheap check avoids.
  rm -f "${DATA_DIR}/expired"
  exit 0
fi

# The expiry flag is written by start-soloist when the daemon exits 10 (see
# the header comment above for the full clear/don't-clear contract).
if [ -f "${DATA_DIR}/expired" ]; then
  echo "Expiry flag present, updating"
  exec /usr/bin/soloist-fetch
fi

if [ ! -f "$VERSION_FILE" ]; then
  echo "Binary present but no version.json (interrupted install, or the data dir was cleared); updating to be safe"
  exec /usr/bin/soloist-fetch
fi

BUILD_INFO=$(python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get("build_date", ""))
    print(d.get("build_date_source", ""))
except Exception:
    pass
' "$VERSION_FILE")

BUILD_DATE=$(printf '%s\n' "$BUILD_INFO" | sed -n 1p)
BUILD_DATE_SOURCE=$(printf '%s\n' "$BUILD_INFO" | sed -n 2p)

if [ -z "$BUILD_DATE" ]; then
  echo "Could not read build_date; updating to be safe"
  exec /usr/bin/soloist-fetch
fi

BUILD_EPOCH=$(date -d "$BUILD_DATE" +%s 2>/dev/null) || BUILD_EPOCH=""
if [ -z "$BUILD_EPOCH" ]; then
  echo "Unparseable build_date '$BUILD_DATE'; updating to be safe"
  exec /usr/bin/soloist-fetch
fi

if [ "$BUILD_DATE_SOURCE" = "parsed" ]; then
  MAX_AGE_DAYS="$MAX_AGE_DAYS_PARSED"
  echo "build_date_source is 'parsed' (read from the binary's --version output); using the ${MAX_AGE_DAYS}-day threshold"
else
  MAX_AGE_DAYS="$MAX_AGE_DAYS_FALLBACK"
  if [ "$BUILD_DATE_SOURCE" = "fallback" ]; then
    echo "build_date_source is 'fallback' (install date used as a lower bound, not a fact); using the more conservative ${MAX_AGE_DAYS}-day threshold"
  else
    echo "build_date_source is '${BUILD_DATE_SOURCE:-<unset>}' (unrecognised); treating it as unreliable and using the more conservative ${MAX_AGE_DAYS}-day threshold"
  fi
fi

NOW_EPOCH=$(date +%s)
if [ "$BUILD_EPOCH" -gt "$NOW_EPOCH" ]; then
  echo "build_date '$BUILD_DATE' is in the future (clock skew or corrupt version.json); updating to be safe"
  exec /usr/bin/soloist-fetch
fi

AGE_DAYS=$(( ( NOW_EPOCH - BUILD_EPOCH ) / 86400 ))
echo "Installed build is ${AGE_DAYS} days old (build_date_source: ${BUILD_DATE_SOURCE:-<unset>})"

if [ "$AGE_DAYS" -ge "$MAX_AGE_DAYS" ]; then
  echo "Age ${AGE_DAYS} days >= ${MAX_AGE_DAYS}-day threshold; updating"
  exec /usr/bin/soloist-fetch
fi

echo "Still fresh (${AGE_DAYS} days < ${MAX_AGE_DAYS}-day threshold), not updating"
exit 0
