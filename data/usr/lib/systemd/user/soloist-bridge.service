[Unit]
Description=Bridge between Spotify Soloist and audiocontrol
After=soloist.service
# No PartOf=soloist.service: this unit is always-on (see [Install] below),
# independent of whether soloist.service is ever started. It tracks
# Soloist's on/off state itself -- _run_loop() re-reads ws.addr/ws.port on
# every connection attempt (Soloist's ephemeral WS port changes on every
# soloist.service restart) and reconnects with capped backoff, and when the
# connection drops it posts state_changed: disconnected to audiocontrol
# (see scripts/soloist-bridge:465-471, in _run_loop's finally: block) so ACR
# never shows a stale state. There is nothing left for soloist.service's
# start/stop lifecycle to drive here, and tying this unit's life to
# soloist.service's would SIGTERM a still-running "Update now" fetch that
# soloist-bridge itself launched as a child (see /install's subprocess.run)
# the moment soloist-fetch restarts the player at the end of a successful
# install.

[Service]
Type=simple
ExecStart=/usr/bin/soloist-bridge
Restart=always
# RestartSec must be well under the default StartLimitIntervalSec (10s) for
# the default StartLimitBurst (5) to actually stop a persistently crashing
# unit rather than restarting forever (see soloist.service's RestartSec
# comment for the full arithmetic). A genuine crash here means a bug, not
# soloist being down -- the WebSocket reconnect loop already absorbs that
# without exiting -- so restarting fast is the right default.
RestartSec=2

# This unit IS its own boot-time trigger, unlike soloist.service. It has to
# be: it is the only server for GET /api/soloist/status and
# POST /api/soloist/install (see scripts/soloist-bridge's module docstring),
# and those must answer even before the user has ever enabled Soloist
# itself (soloist.service ships --no-enable) -- that is precisely the
# WebUI's very first state, "Installed, no binary -> Download Soloist from
# Spotify". Without this [Install] section nothing listens on
# 127.0.0.1:3549 on a freshly installed extension, nginx 502s both routes,
# and the download button can never be reached. The idle cost of running
# this on every boot, including devices that never enable Soloist, is two
# read_text() calls roughly every 30s while nothing is connected
# (_run_loop's capped backoff) -- negligible next to the package's core
# install flow being unreachable without it.
[Install]
WantedBy=default.target
