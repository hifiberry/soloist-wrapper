[Unit]
Description=Spotify Soloist (Spotify Connect player)
After=sound.target network.target pipewire.service
Wants=avahi-daemon.service soloist-bridge.service
# Only one Spotify Connect endpoint may be advertised at a time.
Conflicts=librespot.service

[Service]
Type=simple
ExecStart=/usr/bin/start-soloist
Restart=on-failure
# RestartSec must be well under the default StartLimitIntervalSec (10s) for
# the default StartLimitBurst (5) to ever trip: at RestartSec=10 each retry
# lands right at the edge of a fresh interval window, so the burst counter
# never accumulates and a persistently failing start (e.g. a missing
# /usr/bin/start-soloist) restarts every 10s forever, filling the journal.
# RestartSec=2 (matching sendspin.service) fits five retries inside one
# 10s window, so the default burst limit actually stops the unit instead.
RestartSec=2

[Install]
WantedBy=default.target
