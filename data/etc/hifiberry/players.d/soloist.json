{
    "name": "Spotify (Soloist)",
    "provided_by": "soloist-wrapper",
    "systemd_service": "soloist",
    "icon": "soloist",
    "allow_change": true,
    "conflicts_with": [
        "librespot"
    ],
    "setup": {
        "base_url": "/api/soloist"
    },
    "maintainer_name": "Wanted",
    "maintainer_url": "https://github.com/hifiberry/hifiberry-os/blob/hbosng/docs/maintainers-wanted.md",
    "settings": [
        {
            "key": "api_key",
            "type": "secret",
            "label": "Soloist API key",
            "default": "",
            "description": "Each user needs their own Soloist API key. A Spotify Premium account is required.",
            "help_url": "https://developer.spotify.com/documentation/soloist"
        }
    ]
}
